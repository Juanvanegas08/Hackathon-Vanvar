APP_NAME=CasaLista Voice API
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
SMMLV=0
RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed
CORS_ORIGINS=http://localhost:5173,https://vivienda.colsubsidio.vanvar.tech
PROJECTS_CATALOG_PATH=./data/processed/projects_catalog.json
PROJECT_PROFILES_PATH=./data/processed/project_profiles.json
PROJECT_ALIASES_PATH=./data/processed/project_aliases.json
PROJECTS_CANONICAL_PATH=./data/processed/projects_canonical.json
MOCK_AFFILIATES_PATH=./data/mock/mock_affiliates.json
MOCK_AFFILIATES_HISTORICAL_PATH=./data/mock/mock_affiliates_historical.json
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=coral
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_ENABLED=true
OPENAI_REQUEST_TIMEOUT_SECONDS=45
OPENAI_RECOMMENDER_ENABLED=true
OPENAI_RECOMMENDER_MODEL=gpt-4.1-mini
PREFER_OPENAI_RECOMMENDATIONS=true
OPENAI_PHONE_MODEL=gpt-4.1-mini

# Twilio Voice. En producción: HTTPS público del API (sin slash final).
# En local: tunnel HTTPS (ngrok/loca.lt) apuntando al puerto del backend.
# TWILIO_VOICE_MODE=gather funciona sin onboarding ConversationRelay.
# Usa conversation_relay tras el onboarding en Console (menor latencia).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_PUBLIC_BASE_URL=https://api.vivienda.colsubsidio.vanvar.tech
TWILIO_VALIDATE_SIGNATURE=true
TWILIO_VOICE_MODE=conversation_relay
# Phone Laura = same OpenAI Realtime brain as web; only TTS differs (ElevenLabs).
TWILIO_TTS_PROVIDER=ElevenLabs
# Prefer a LatAm/Colombian ElevenLabs voice. Optional suffixes Twilio accepts:
#   <voiceId>-flash_v2_5
#   <voiceId>-1.05_0.6_0.8  (speed_stability_similarity)
TWILIO_TTS_VOICE=
# Deepgram + short speech timeout = snappier turn-taking on phone.
TWILIO_TRANSCRIPTION_PROVIDER=Deepgram
TWILIO_SPEECH_MODEL=nova-2-general
TWILIO_SPEECH_TIMEOUT_MS=600
# Same model family as web voice (used by phone Realtime WS).
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_PHONE_MODEL=gpt-4.1-mini
SCHEDULED_CALL_POLL_SECONDS=30

DATABASE_ENABLED=true
DATABASE_URL=postgresql+psycopg://casalista_app:password@localhost:5432/home_30x
DATABASE_ADMIN_URL=
DATABASE_NAME=home_30x

DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_COMMAND_TIMEOUT_SECONDS=30

DATABASE_MIGRATION_LOCK_ID=741852963
PERSISTENCE_PROVIDER=postgres
IDENTITY_HASH_PEPPER=casalista-dev-pepper

TEST_DATABASE_URL=
