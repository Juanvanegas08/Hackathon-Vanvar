# =============================================================================
# CasaLista Voice API — plantilla (.env.example)
# Copia a .env y completa secretos. NO subas .env a git.
# Producción ACTIVA en el ejemplo | Desarrollo comentado
# =============================================================================

APP_NAME=CasaLista Voice API
API_PREFIX=/api/v1
SMMLV=0

# -----------------------------------------------------------------------------
# PRODUCCIÓN (activa)
# -----------------------------------------------------------------------------
APP_ENV=production
DEBUG=false
CORS_ORIGINS=https://vivienda.colsubsidio.vanvar.tech
RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed
PROJECTS_CATALOG_PATH=./data/processed/projects_catalog.json
PROJECT_PROFILES_PATH=./data/processed/project_profiles.json
PROJECT_ALIASES_PATH=./data/processed/project_aliases.json
PROJECTS_CANONICAL_PATH=./data/processed/projects_canonical.json
MOCK_AFFILIATES_PATH=./data/mock/mock_affiliates.json
MOCK_AFFILIATES_HISTORICAL_PATH=./data/mock/mock_affiliates_historical.json
LEAD_PROFILES_PATH=./data/profiles

OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=coral
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_ENABLED=true
OPENAI_REQUEST_TIMEOUT_SECONDS=60
OPENAI_RECOMMENDER_ENABLED=true
OPENAI_RECOMMENDER_MODEL=gpt-4.1-mini
PREFER_OPENAI_RECOMMENDATIONS=true
OPENAI_PHONE_MODEL=gpt-4.1-mini

DATABASE_ENABLED=true
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@10.8.0.1:5432/home_30x
DATABASE_ADMIN_URL=postgresql+psycopg://USER:PASSWORD@10.8.0.1:5432/postgres
DATABASE_NAME=home_30x
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_COMMAND_TIMEOUT_SECONDS=30
DATABASE_MIGRATION_LOCK_ID=741852963
PERSISTENCE_PROVIDER=postgres
IDENTITY_HASH_PEPPER=casalista-prod-pepper
TEST_DATABASE_URL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_PUBLIC_BASE_URL=https://api.vivienda.colsubsidio.vanvar.tech
TWILIO_VALIDATE_SIGNATURE=true
SCHEDULED_CALL_POLL_SECONDS=30

GUNICORN_BIND=127.0.0.1:8100
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info
RUN_MIGRATIONS=1

# -----------------------------------------------------------------------------
# DESARROLLO (comentado)
# -----------------------------------------------------------------------------
# APP_ENV=development
# DEBUG=true
# CORS_ORIGINS=http://localhost:5173
# OPENAI_API_KEY=
