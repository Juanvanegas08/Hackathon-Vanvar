# Build de producción del frontend CasaLista Vivienda
#
# Antes de `npm run build` en el VPS:
#   cp .env.production.example .env.production
#   (ajusta si cambia el dominio de la API)

VITE_API_BASE_URL=https://api.vivienda.colsubsidio.vanvar.tech
VITE_DEMO_MODE=true
VITE_VOICE_PROVIDER=openai
VITE_VOICE_ENABLED=true
VITE_ADVISOR_MOCK=false
